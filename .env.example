# ── Base de datos ─────────────────────────────────────────────
# Opción 1 (nube): una sola URL, como la entrega Railway/Render/Neon.
# DATABASE_URL=postgresql://usuario:clave@host:5432/asi
# Opción 2 (local): en partes. Se ignoran si está DATABASE_URL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asi
DB_USER=tu_usuario_postgres
DB_PASSWORD=cambiar_esto
# off = local sin SSL · require = cifrado (bases en la nube) · verify = cifrado + valida certificado
DB_SSL=off

# ── API ───────────────────────────────────────────────────────
JWT_SECRET=generar_con_openssl_rand_-hex_32_minimo_32_caracteres
PORT=3000
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,https://localhost:5500,https://127.0.0.1:5500
# Proxies HTTPS delante del servidor: 1 en Railway/Render, 0 en local
TRUST_PROXY=0
